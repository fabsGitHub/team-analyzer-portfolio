# docker/Dockerfile.backend (final)
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace

COPY backend/pom.xml backend/pom.xml
RUN mvn -f backend/pom.xml -q -Dmaven.test.skip=true dependency:go-offline

COPY backend/src backend/src
RUN mvn -f backend/pom.xml -Dmaven.test.skip=true clean package

FROM eclipse-temurin:21-jre
WORKDIR /app
# Kopiert nur das App-JAR und benennt es direkt app.jar
COPY --from=build /workspace/backend/target/team-radar-*.jar /app/app.jar
EXPOSE 8080
ENTRYPOINT ["java","-jar","/app/app.jar"]
