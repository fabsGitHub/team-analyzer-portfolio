{
  "name": "team-analyzer-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Vue 3 single-page app for Team Analyzer",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc -b",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write src cypress",
    "test:component": "cypress run --component"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/cypress": "^10.1.3",
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^16.2.1",
    "eslint": "^9.34.0",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^8.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.14"
  }
}
