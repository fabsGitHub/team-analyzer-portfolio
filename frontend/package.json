{
  "name": "team-analyzer-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Vue 3 single-page app for Team Analyzer",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc -b",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write src cypress",
    "test:component": "cypress run --component"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "vue": "^3.5.18",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@testing-library/cypress": "^10.1.0",
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/tsconfig": "^0.7.0",
    "cypress": "^15.3.0",
    "eslint": "^9.34.0",
    "eslint-plugin-vue": "^10.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vite-plugin-vue-devtools": "^8.0.1",
    "vue-tsc": "^3.0.5"
  }
}
