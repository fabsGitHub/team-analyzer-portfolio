# Container image for the Vercel "backend" service (build context: backend/).
# The local Docker Compose stack uses docker/Dockerfile.backend instead.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml ./
RUN mvn --batch-mode --no-transfer-progress -Dmaven.test.skip=true dependency:go-offline
COPY src/ ./src/
RUN mvn --batch-mode --no-transfer-progress -Dmaven.test.skip=true package

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN groupadd --system spring && useradd --system --gid spring --home-dir /app --shell /usr/sbin/nologin spring
COPY --from=build --chown=spring:spring /workspace/target/team-analyzer.jar /app/app.jar
USER spring
EXPOSE 8080
# Vercel stops the container after a few idle minutes, so start-up time is what visitors feel.
# C1-only JIT and the serial GC start about a third faster on a small container; peak throughput
# matters little for this demo.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -XX:TieredStopAtLevel=1 -XX:+UseSerialGC"
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
