FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml ./
RUN mvn --batch-mode --no-transfer-progress -Dmaven.test.skip=true dependency:go-offline
COPY src/ ./src/
RUN mvn --batch-mode --no-transfer-progress -Dmaven.test.skip=true clean package

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN groupadd --system spring && useradd --system --gid spring --home-dir /app --shell /usr/sbin/nologin spring
COPY --from=build --chown=spring:spring /workspace/target/team-radar-0.1.0.jar /app/app.jar
USER spring
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
