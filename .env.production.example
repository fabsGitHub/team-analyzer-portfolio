# Local Docker Compose settings. Copy to .env.production (ignored by Git) and fill in every value.
# Use a fresh random value for each secret and never reuse values from the repository history:
#   openssl rand -base64 32   -> APP_JWT_SECRET_BASE64
#   openssl rand -hex 32      -> passwords and the two HMAC secrets (64 characters)

MYSQL_USER=team_analyzer
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

APP_JWT_SECRET_BASE64=
EMAIL_VERIFY_HMAC_SECRET=
DOWNLOAD_TOKEN_HMAC_SECRET=

# Local demos only: print verification and password-reset links to the backend log,
# because the local stack has no mail server.
LOG_VERIFICATION_LINK=false

# Optional: this address becomes administrator once it is registered and confirmed.
APP_BOOTSTRAP_ADMIN_EMAIL=

# Optional: enables "Try the demo" (POST /api/demo/session), which creates a private sample
# workspace that is deleted after 24 hours.
APP_DEMO_ENABLED=false

# Only needed for the optional tooling overlay (docker/docker-compose.tools.yml).
SONAR_DB_PASSWORD=

# Configure these on Vercel as encrypted environment variables for the hosted demo
# (see docs/VERCEL_DEPLOYMENT.md):
# SPRING_PROFILES_ACTIVE=prod
# MYSQL_HOST=<TiDB SQL host>
# MYSQL_PORT=4000
# MYSQL_DATABASE=teambase
# MYSQL_USER=<TiDB SQL user>
# MYSQL_PASSWORD=<TiDB SQL password>
# APP_FRONTEND_BASE_URL=https://team-analyzer-demo.vercel.app
# APP_DEMO_ENABLED=true
# APP_MAIL_PROVIDER=brevo-api
# BREVO_API_KEY=<Brevo API key>
# SPRING_MAIL_FROM=<verified Brevo sender address>
# SPRING_MAIL_FROM_NAME=Team Analyzer
